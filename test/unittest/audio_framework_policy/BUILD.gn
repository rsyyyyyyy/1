# ==================== Audio Framework Policy AIUT ====================
# Aggregates AIUT tests for audio policy domain.
# Sub-groups: device, volume, common (default)
# Unclassified policy AIUTs default to audio_policy_common.
group("audio_framework_policy_aiut") {
  testonly = true
  deps = [
    "audio_policy_common:audio_policy_common_aiut",
    "audio_policy_device:audio_policy_device_aiut",
    "audio_policy_volume:audio_policy_volume_aiut",
    "audio_policy_interrupt:audio_policy_interrupt_aiut",
    "audio_policy_route:audio_policy_route_aiut",
    "audio_policy_stream:audio_policy_stream_aiut",
  ]
}