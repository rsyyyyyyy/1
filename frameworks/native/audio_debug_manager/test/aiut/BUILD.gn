import("//build/test.gni")
import("../../../../../config.gni")

# Module output path mapping
audio_debug_manager_output_path = "audio_framework/audio_framework_route"
audio_renderer_output_path = "audio_framework/audio_route_renderer"
audio_capturer_output_path = "audio_framework/audio_route_capturer"
audio_loopback_output_path = "audio_framework/audio_framework_engine"
audio_session_output_path = "audio_framework/audio_framework_focus"

# Common includes and flags shared by all AIUT modules
_aiut_include_dirs = [
  "./include",
  "../../include",
  "../../../../../test/unittest/common/include",
  "../../../../../interfaces/inner_api/native/audiocommon/include",
  "../../../../../interfaces/inner_api/native/audio_debug_manager/include",
  "../../../../../interfaces/kits/c/audio_manager",
  "../../../../../interfaces/kits/c/common",
  "../../../audiodefinitions/include",
  "../../../audioutils/include",
  "../../../../js/napi/audiomanager",
]

_aiut_cflags = [
  "-Wall",
  "-Werror",
  "-Wno-macro-redefined",
  "-fno-access-control",
]

_aiut_deps = [
  "../../../audiodefinitions:audio_definitions",
  "../../../audioutils:audio_utils",
  "../../../ohaudio:ohaudio",
]

_aiut_external_deps = [
  "c_utils:utils",
  "hilog:libhilog",
  "ipc:ipc_single",
]

# ==================== debug_manager (common methods + OHAudio/Taihe/NAPI AppInfo) ====================

ohos_unittest("audio_debugging_manager_aiut") {
  testonly = true
  module_out_path = audio_debug_manager_output_path

  include_dirs = _aiut_include_dirs
  cflags = _aiut_cflags
  cflags_cc = [ "-std=c++20" ]

  sources = [
    "src/audio_debugging_manager_aiut.cpp",
    "../../src/audio_debug_manager.cpp",
  ]

  deps = _aiut_deps
  external_deps = _aiut_external_deps
}

# ==================== renderer (native + OHAudio + Taihe + NAPI) ====================

ohos_unittest("audio_renderer_debugging_manager_aiut") {
  testonly = true
  module_out_path = audio_renderer_output_path

  include_dirs = _aiut_include_dirs
  cflags = _aiut_cflags
  cflags_cc = [ "-std=c++20" ]

  sources = [
    "src/audio_renderer_debugging_manager_aiut.cpp",
    "../../src/audio_debug_manager.cpp",
  ]

  deps = _aiut_deps
  external_deps = _aiut_external_deps
}

# ==================== capturer (native + OHAudio + Taihe + NAPI) ====================

ohos_unittest("audio_capturer_debugging_manager_aiut") {
  testonly = true
  module_out_path = audio_capturer_output_path

  include_dirs = _aiut_include_dirs
  cflags = _aiut_cflags
  cflags_cc = [ "-std=c++20" ]

  sources = [
    "src/audio_capturer_debugging_manager_aiut.cpp",
    "../../src/audio_debug_manager.cpp",
  ]

  deps = _aiut_deps
  external_deps = _aiut_external_deps
}

# ==================== loopback (native + Taihe + NAPI) ====================

ohos_unittest("audio_loopback_debugging_manager_aiut") {
  testonly = true
  module_out_path = audio_loopback_output_path

  include_dirs = _aiut_include_dirs
  cflags = _aiut_cflags
  cflags_cc = [ "-std=c++20" ]

  sources = [
    "src/audio_loopback_debugging_manager_aiut.cpp",
    "../../src/audio_debug_manager.cpp",
  ]

  deps = _aiut_deps
  external_deps = _aiut_external_deps
}

# ==================== session (native + OHAudio + Taihe + NAPI) ====================

ohos_unittest("audio_session_debugging_manager_aiut") {
  testonly = true
  module_out_path = audio_session_output_path

  include_dirs = _aiut_include_dirs
  cflags = _aiut_cflags
  cflags_cc = [ "-std=c++20" ]

  sources = [
    "src/audio_session_debugging_manager_aiut.cpp",
    "../../src/audio_debug_manager.cpp",
  ]

  deps = _aiut_deps
  external_deps = _aiut_external_deps
}

# ==================== Group: all AIUT targets ====================

group("audio_debug_manager_aiut") {
  testonly = true
  deps = [
    ":audio_debugging_manager_aiut",
    ":audio_renderer_debugging_manager_aiut",
    ":audio_capturer_debugging_manager_aiut",
    ":audio_loopback_debugging_manager_aiut",
    ":audio_session_debugging_manager_aiut",
  ]
}
