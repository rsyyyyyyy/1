import("//build/test.gni")
import("../../../../../config.gni")

audio_clock_aiut_output_path = "audio_framework/audio_framework_route/audioclock"

aiut_include_dirs = [
  "./include",
  "../../include",
  "../../../../../test/unittest/common/include",
  "../../../../../interfaces/inner_api/native/audiocommon/include",
  "../../../audioutils/include",
]

aiut_cflags = [
  "-Wall",
  "-Werror",
  "-Wno-macro-redefined",
  "-fno-access-control",
]

aiut_deps = [
  "../../:audio_clock",
  "../../../audioutils:audio_utils",
]

aiut_external_deps = [
  "c_utils:utils",
  "googletest:gmock",
  "googletest:gtest",
  "hilog:libhilog",
  "ipc:ipc_single",
]

ohos_unittest("audio_clock_native_aiut") {
  testonly = true
  module_out_path = audio_clock_aiut_output_path
  include_dirs = aiut_include_dirs
  cflags = aiut_cflags
  cflags_cc = [ "-std=c++20" ]
  sources = [
    "src/audio_clock_aiut.cpp",
  ]
  deps = aiut_deps
  external_deps = aiut_external_deps
}

group("audio_clock_aiut") {
  testonly = true
  deps = [
    ":audio_clock_native_aiut",
  ]
}
