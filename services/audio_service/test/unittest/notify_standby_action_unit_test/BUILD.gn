import("//build/ohos.gni")
import("//build/test.gni")
import("../../../../../config.gni")

module_output_path = "audio_framework/audio_framework_route/audio_server"

config("module_private_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "../../../server/include",
    "../../../../../frameworks/native/audioutils/include",
  ]
}

ohos_unittest("notify_standby_action_unit_test") {
  testonly = true
  module_out_path = module_output_path

  cflags = [ "-fno-access-control" ]

  sources = [ "./src/notify_standby_action_unit_test.cpp" ]

  include_dirs = [
    "./include",
    "../../../server/include",
    "../../../../../frameworks/native/audioutils/include",
  ]

  configs = [ ":module_private_config" ]

  deps = [
    "../../../../../frameworks/native/audioutils:audio_utils",
    "../../../../../services/audio_service:audio_service",
    "../../../../audio_service:audio_process_service_static",
  ]

  external_deps = [
    "googletest:gtest",
    "hilog:libhilog",
    "c_utils:utils",
  ]
}