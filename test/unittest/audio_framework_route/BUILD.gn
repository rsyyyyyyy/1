import("//foundation/multimedia/audio_framework/config.gni")

# ==================== Audio Framework Route AIUT ====================
# Aggregates AIUT tests for audio route (local data path) domain.
# Sub-groups: capturer, renderer, common (default), manager
# Unclassified AIUTs default to audio_route_common.
group("audio_framework_route_aiut") {
  testonly = true
  deps = [
    "audio_route_capturer:audio_route_capturer_aiut",
    "audio_route_common:audio_route_common_aiut",
    "audio_route_manager:audio_route_manager_aiut",
    "audio_route_renderer:audio_route_renderer_aiut",
  ]
}