import("//build/config/features.gni")
import("//build/test.gni")
import("../../../accessibility.gni")
import("../../../config.gni")

ohos_fuzztest("HpaeSourceProcessClusterFuzzTest") {
  module_out_path = "audio_framework/audio_framework_engine"
  fuzz_config_file = "../hpaesourceprocesscluster_fuzzer"

  include_dirs = [
    "../../../services/audio_engine/node/include",
    "../../../services/audio_engine/manager/include",
    "../../../services/audio_engine/include",
    "../../../services/audio_engine/test/unittest/common",
    "../../../frameworks/native/audioutils/include",
    "../../../services/audio_service/common/include",
    "../../../services/audio_policy/common/include",
    "../../../interfaces/inner_api/native/audiocommon/include",
    "../../../frameworks/native/audioeffect/include",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-fno-access-control",
    "-DENABLE_HIDUMP_DFX",
    "-DENABLE_HOOK_PCM",
  ]

  configs = [
    "../../../services/audio_engine:audio_engine_node_config",
  ]

  sources = [
    "hpaesourceprocesscluster_fuzzer.cpp",
  ]

  deps = [
    "../../../frameworks/native/audioutils:audio_utils",
    "../../../frameworks/native/audioclock:audio_clock",
    "../../../services/audio_engine:hpae_engine_manager",
    "../../../services/audio_engine:audio_engine_node",
    "../../../services/audio_engine:audio_engine_utils",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hdf_core:libhdi",
    "hilog:libhilog",
    "hicollie:libhicollie",
    "hisysevent:libhisysevent",
    "ipc:ipc_single",
  ]

  defines = []
  if (use_libfuzzer || use_clang_coverage) {
    defines += [ "TEST_COVERAGE" ]
  }
  if (audio_framework_feature_dtmf_tone) {
    defines += [ "FEATURE_DTMF_TONE" ]
  }
  if (audio_framework_feature_input) {
    defines += [ "FEATURE_MULTIMODALINPUT_INPUT" ]
  }
}

group("fuzztest") {
  testonly = true
  deps = [ ":HpaeSourceProcessClusterFuzzTest" ]
}
