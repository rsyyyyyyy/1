import("//foundation/multimedia/audio_framework/config.gni")

# ==================== Audio Framework Common AIUT ====================
# Default AIUT group for audio_framework_aiut.
# Any AIUT without a clear functional domain classification goes here.
group("audio_framework_common_aiut") {
  testonly = true
  deps = [
    "../../frameworks/native/audioutils:audio_utils_aiut",
    "../../frameworks/native/audio_debug_manager:audio_debug_manager_test",
    "../../frameworks/native/ohaudio/test/unittest/oh_audio_stream_manager_test:oh_audio_stream_manager_aiut_group",
    "../../frameworks/native/ohaudio/test/unittest/oh_audio_workgroup_test:oh_audio_workgroup_aiut_group",
    "../../frameworks/native/audiodefinitions:audio_stream_descriptor_aiut_group",
  ]

  if (speex_enable == true) {
    deps += [ "../../frameworks/native/hdiadapter_new:hdiadapter_aiut" ]
  }
}