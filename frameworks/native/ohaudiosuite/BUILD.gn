import("//build/ohos.gni")
import("../../../config.gni")

config("audio_config") {
  include_dirs = [
    "../audioutils/include/",
    "../../../interfaces/inner_api/native/audiocommon/include",
    "../../../interfaces/inner_api/native/audiosuite/include",
  ]

  cflags = [
    "-Wall",
    "-Werror",
  ]
}

ohos_shared_library("ohaudiosuite") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
  }
  include_dirs = [
    "../../../interfaces/kits/c/",
    "../../../interfaces/kits/c/common/",
    "../../../interfaces/kits/c/audio_suite/",
    "../../../services/audio_suite/client/stub/include",
    "../../../services/audio_suite/idl",
    "../../../services/audio_suite/client/utils/include",
    "../../../services/audio_service/common/include/dfx",
  ]

  configs = [ ":audio_config" ]

  if (audio_framework_feature_audiosuite_support) {
    sources = [
      "./OHAudioSuiteEngine.cpp",
      "./OHAudioSuiteNodeBuilder.cpp",
      "./OHAudioSuiteFormatConverter.cpp",
      "./OHAudioSuiteDownloadManager.cpp",
    ]

    deps = [
      "../../../services/audio_suite:audio_suite",
      "../../../services/audio_engine:audio_common_algorithm",
      "../../../services/audio_engine:audio_engine_utils",
      "../../../services/audio_service:audio_common",
      "../audioutils:audio_utils",
    ]

    cflags = [
      "-Werror",
      "-Os",
      "-ffunction-sections",
      "-fdata-sections",
    ]

    ldflags = [
      "-Wl,-gc-sections",
    ]

    external_deps = [
      "bounds_checking_function:libsec_shared",
      "c_utils:utils",
      "hilog:libhilog",
      "ipc:ipc_single",
    ]
  }

  version_script = "ohaudiosuite.versionscript"

  innerapi_tags = [ "ndk" ]

  output_name = "ohaudiosuite"
  output_extension = "so"
  subsystem_name = "multimedia"
  part_name = "audio_framework"
}
