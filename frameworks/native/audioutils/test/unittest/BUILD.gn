import("//build/test.gni")
import("../../../../../config.gni")
route_common_module_output_path = "audio_framework/audio_route_common/audio_utils"

group("unit_test_group") {
  testonly = true

  deps = [
    ":async_action_handler_test",
    ":audio_bundle_manager_test",
    ":audio_speed_unit_test",
    ":audio_utils_plus_unit_test",
    ":audio_utils_pro_unit_test",
    ":audio_utils_third_unit_test",
    ":audio_utils_unit_test",
    ":audio_sink_latency_fetcher_test",
    ":audio_utils_container_aiut",
    ":audio_utils_dfx_aiut",
    ":audio_utils_misc_aiut",
  ]
}

ohos_unittest("audio_utils_unit_test") {
  module_out_path = route_common_module_output_path
  include_dirs = [
    "../../include",
    "../../../../../interfaces/inner_api/native/audiocommon/include/",
  ]

  cflags = [
    "-Wall",
    "-Werror",
    "-fno-access-control",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "googletest:gmock",
    "googletest:gtest",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_single",
  ]

  if (sonic_enable == true) {
    cflags += [ "-DSONIC_ENABLE" ]
  }

  if (sonic_enable == true) {
    external_deps += [ "sonic:sonic" ]
  }

  sources = [
    "../../../audioutils/src/audio_channel_blend.cpp",
    "audio_utils_unit_test.cpp",
    "audio_utils_second_unit_test.cpp",
  ]

  deps = [ "../../../audioutils:audio_utils" ]
}

