    # Anchored mangling INSTEAD of the usual *AudioXmlNode* wildcard: the
    # TU-local implementation class AudioXmlNodeInner (audio_xml_parser.cpp,
    # in no header) contains that substring and would leak ~15 internal
    # symbols. The "12" length prefix pins the match to the interface
    # (Inner mangles as ...18AudioXmlNodeInner...).
    #
    # vtable/typeinfo exact names keep RC02 available for any cross-DSO
    # typeid/dynamic_cast under cfi_cross_dso; no virtual bases -> no thunks.
    _ZN4OHOS13AudioStandard12AudioXmlNode*;
    _ZTVN4OHOS13AudioStandard12AudioXmlNodeE;
    _ZTIN4OHOS13AudioStandard12AudioXmlNodeE;
    _ZTSN4OHOS13AudioStandard12AudioXmlNodeE;

    # ---- DlopenUtils libxml2 dlopen lifecycle (same header) ----
    # Init/DeInit are called by name from audio_policy_server.cpp:336/360
    # and audio_server.cpp:959/995. No other symbol defined in this DSO
    # contains "DlopenUtils", so the plain wildcard is exact.
    *DlopenUtils*;
  local:
    *;
};

