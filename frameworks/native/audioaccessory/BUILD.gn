import("//build/ohos.gni")
import("../../../config.gni")

config("audio_accessory_config") {
  include_dirs = [
    "./include",
    "../audioutils/include/",
    "../../../interfaces/inner_api/native/audiocommon/include",
    "../../../interfaces/inner_api/native/audiomanager/include",
    "../../../interfaces/kits/c/common/",
    "../../../interfaces/kits/c/audio_manager/",
  ]

  cflags = [
    "-Wall",
    "-Werror",
  ]
}

ohos_shared_library("audio_accessory") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
  }

  configs = [ ":audio_accessory_config" ]

  sources = [
    "./src/audio_accessory.cpp",
    "./src/audio_accessory_input_stream.cpp",
  ]

  deps = [
    "../../../services/audio_service:audio_common",
    "../../../services/audio_policy:audio_policy_client",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "hilog:libhilog",
    "c_utils:utils",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "multimedia"
  part_name = "audio_framework"
}
