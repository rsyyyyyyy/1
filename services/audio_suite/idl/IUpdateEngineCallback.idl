package OHOS.AudioStandard.AudioSuite;
import AudioSuiteSaTypes;
sequenceable OHOS.IRemoteObject;

interface IUpdateEngineCallback {
    [ipccode 1] int GetFeatureNewVersion([in] CheckCondition checkCondition,
        [in] FeatureInfo[] featureInfos,
        [out] CloudRomCheckResult newVersionInfos);
    [ipccode 2] int GetFeatureStatus([in] FeatureInfo[] featureInfos,
        [out] StatusInfoResult statusInfos);
    [ipccode 3] int DownloadAndInstall([in] DownloadCondition downloadCondition,
        [in] FeatureInfo[] featureInfos,
        [out] BusinessError businessError);
    [ipccode 4] int CancelCloudRom([in] FeatureInfo[] featureInfos,
        [out] BusinessError businessError);
    [ipccode 5] int UninstallCloudRom([in] FeatureInfo[] featureInfos,
        [out] BusinessError businessError);
    [ipccode 6] int RegisterCloudRomCallback([in] IRemoteObject object);
    [ipccode 7] int UnregisterCloudRomCallback();
};
