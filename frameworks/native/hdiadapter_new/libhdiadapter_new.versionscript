# Strict whitelist for libhdiadapter_new.z.so (target "hdiadapter_new").
# Replaces the former umbrella script (global: *;  == no governance at all).
# Every entry below is verified by-name referenced across DSO boundaries by
# production consumers (audio_engine / audio_policy / audio_service), by the
# hdiadapter AIUT+unittest suites (which construct sinks/sources/managers via
# make_shared), or by cross-DSO derivation in audio_service.

1.0 {
  global:
    *AudioRenderSink*;
    *AuxiliarySink*;
    *IAudioSinkCallback*;
    *AudioCaptureSource*;
    *VACaptureSource*;
    *IAudioSourceCallback*;
    *DeviceManager*;
    *HdiAdapterFactory*;
    *HdiAdapterManager*;
    *HdiMonitor*;
    *SinkCallbackWrapper*;
    *SourceCallbackWrapper*;
    *IdHandler*;
    *RingBufferHandler*;
    *AudioRunningLock*;
    *AudioPlayingAppManager*;
    *AudioHdiVersionManager*;
  local:
    *;
};