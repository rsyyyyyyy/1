import("//build/config/features.gni")
import("//build/test.gni")
import("../../../accessibility.gni")
import("../../../config.gni")

ohos_fuzztest("EffectInstanceFuzzTest") {
  module_out_path = "audio_framework/audio_framework_engine"
  fuzz_config_file = "../effectinstance_fuzzer"

  include_dirs = [
    "../../../services/audio_engine/manager/include",
    "../../../services/audio_engine/node/include",
    "../../../services/audio_engine/buffer",
    "../../../services/audio_engine/utils",
    "../../../services/audio_engine/dfx",
    "../../../services/audio_engine/simd",
    "../../../services/audio_engine/test/unittest/common",
    "../../../interfaces/inner_api/native/audiocommon/include",
    "../../../services/audio_service/server/include",
    "../../../services/audio_service/common/include",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  cflags_cc = [ "-fno-access-control" ]

  sources = [ "effectinstance_fuzzer.cpp" ]

  deps = [
    "../../../services/audio_engine:hpae_engine_manager",
    "../../../services/audio_engine:audio_engine_utils",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]

  defines = []
  if (use_libfuzzer || use_clang_coverage) {
    defines += [ "TEST_COVERAGE" ]
  }
}

group("fuzztest") {
  testonly = true
  deps = [ ":EffectInstanceFuzzTest" ]
}
