package OHOS.AudioStandard.AudioSuite;

import AudioSuiteTypes;

sequenceable OHOS.IRemoteObject;

interface IAudioSuiteService {
    [ipccode 1] int RegisterDownloadStatusCallback([in] IRemoteObject object);
    int UnregisterDownloadStatusCallback();
    int StartDownload([in] String version, [in] boolean allowedCellularNet);
    int PauseDownload([in] String version);
    int CancelDownload([in] String version);
    int StartBackgroundDownload([in] String version);
    int GetDownloadStatus([in] String version, [out] AudioSuiteDownloadStatusInfo status);
    int UninstallCloudRom([in] String version);

    int RegisterDownloadInterfaceCallback([in] IRemoteObject object);
    int UnregisterDownloadInterfaceCallback();
    [oneway] void OnDownloadStatusChanged([in] AudioSuiteDownloadStatusInfo[] status);
};
