import("//build/ohos.gni")
import("//build/test.gni")
import("../../../../../../accessibility.gni")
import("../../../../../../appgallery.gni")
import("../../../../../../bluetooth_part.gni")
import("../../../../../../config.gni")

module_output_path = "audio_framework/audio_framework_policy/audio_policy"

ohos_unittest("window_utils_unit_test") {
  module_out_path = module_output_path
  include_dirs = [
    "./unittest/window_utils_unit_test/include",
  ]

  use_exceptions = true

  cflags = [
    "-Wall",
    "-Werror",
    "-Wno-macro-redefined",
    "-fno-access-control",
  ]

  cflags_cc = cflags

  external_deps = [
    "c_utils:utils",
    "googletest:gmock",
    "hilog:libhilog",
    "init:libbegetutil",
    "ffrt:libffrt",
  ]

  sources = [ "./unittest/window_utils_unit_test/src/window_utils_unit_test.cpp" ]

  deps = [
    "../../../../../audio_policy:audio_policy_service_static",
  ]
}
