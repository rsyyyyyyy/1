package OHOS.AudioStandard.AudioSuite;

enum DownloadState {
    DOWNLOAD_IDLE = 0,
    DOWNLOAD_WAITING = 1,
    DOWNLOAD_IN_PROGRESS = 2,
    DOWNLOAD_COMPLETED = 3,
    DOWNLOAD_FAILED = 4,
    DOWNLOAD_CANCELLED = 5,
};

struct DownloadStatus {
    DownloadState state;
    int progress;
    String version;
    String romPath;
    int errorCode;
    String errMessage;
    long fileSize;
};

enum CloudRomStatus {
    ERROR = -1,
    INIT = 0,
    CHECKING_VERSION = 10,
    CHECK_VERSION_FAIL = 11,
    CHECK_VERSION_SUCCESS = 12,
    DOWNLOADING = 20,
    DOWNLOAD_PAUSE = 21,
    DOWNLOAD_FAIL = 22,
    DOWNLOAD_SUCCESS = 23,
    INSTALLING = 30,
    WAIT_REBOOT_THEN_INSTALL = 31,
    WAIT_UPGRADE_THEN_INSTALL = 32,
    RESTARTED_WAIT_FOR_INSTALL = 33,
    UPGRADED_WAIT_FOR_INSTALL = 34,
    INSTALL_FAIL = 35,
    INSTALL_SUCCESS = 36,
    UNINSTALLING = 40,
    WAIT_REBOOT_THEN_UNINSTALL = 41,
    UNINSTALL_FAIL = 42,
    UNINSTALL_SUCCESS = 43,
};

enum SecurityLevel {
    DEFAULT = 0,
    HIGH = 1,
    LOW = 2,
};

struct BusinessError {
    String message;
    int errorNum;
};

struct FeatureInfo {
    String featureName;
    String info;
};

struct StatusInfo {
    FeatureInfo featureInfo;
    String version;
    CloudRomStatus status;
    String installPath;
    int progress;
    BusinessError errorInfo;
};

struct CloudRomNewVersionInfo {
    FeatureInfo featureInfo;
    String version;
    CloudRomStatus status;
    long size;
    SecurityLevel securityLevel;
    String description;
    String versionExtraInfo;
    BusinessError errorInfo;
};

struct CloudRomCheckResult {
    CloudRomNewVersionInfo[] newVersionInfos;
    BusinessError errorInfo;
};

struct StatusInfoResult {
    StatusInfo[] statusInfos;
    BusinessError errorInfo;
};

struct CheckCondition {
    String language;
    String condition;
};

struct DownloadCondition {
    int allowedNetType;
    String condition;
    boolean isBackground;
};

struct PauseCondition {
    String reason;
    boolean autoResume;
    String condition;
};

struct CloudRomCallback {
    StatusInfo[] statusInfos;
};
