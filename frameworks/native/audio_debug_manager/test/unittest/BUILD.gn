import("//build/test.gni")
import("../../../../../config.gni")

# Module output path for supplementary standard GTest targets
audio_debug_manager_supplement_output_path = "audio_framework/audio_debug_manager_supplement"

# Common includes and flags for standard GTest
_supplement_include_dirs = [
  "../../include",
  "../../../../../test/unittest/common/include",
  "../../../../../interfaces/inner_api/native/audiocommon/include",
  "../../../../../interfaces/inner_api/native/audio_debug_manager/include",
  "../../../audiodefinitions/include",
  "../../../audioutils/include",
]

_supplement_cflags = [
  "-Wall",
  "-Werror",
  "-Wno-macro-redefined",
  "-fno-access-control",
]

_supplement_deps = [
  "../../../audiodefinitions:audio_definitions",
  "../../../audioutils:audio_utils",
]

_supplement_external_deps = [
  "c_utils:utils",
  "googletest:gmock",
  "googletest:gtest",
  "hilog:libhilog",
  "ipc:ipc_single",
]

# ==================== Part A: GetInstance / PrintApp / KeyGen / Renderer ====================

ohos_unittest("audio_debug_manager_unit_test") {
  testonly = true
  module_out_path = audio_debug_manager_supplement_output_path

  include_dirs = _supplement_include_dirs
  cflags = _supplement_cflags
  cflags_cc = [ "-std=c++20" ]

  sources = [
    "src/audio_debug_manager_unit_test.cpp",
    "../../src/audio_debug_manager.cpp",
  ]

  deps = _supplement_deps
  external_deps = _supplement_external_deps
}

# ==================== Part B: Capturer / Loopback / Session ====================

ohos_unittest("audio_debug_manager_unit_test_b") {
  testonly = true
  module_out_path = audio_debug_manager_supplement_output_path

  include_dirs = _supplement_include_dirs
  cflags = _supplement_cflags
  cflags_cc = [ "-std=c++20" ]

  sources = [
    "src/audio_debug_manager_unit_test_b.cpp",
    "../../src/audio_debug_manager.cpp",
  ]

  deps = _supplement_deps
  external_deps = _supplement_external_deps
}

# ==================== Group: all supplementary standard GTest targets ====================

group("audio_debug_manager_supplement") {
  testonly = true
  deps = [
    ":audio_debug_manager_unit_test",
    ":audio_debug_manager_unit_test_b",
  ]
}
