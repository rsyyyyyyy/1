import("//build/test.gni")
import("../../../../../../../config.gni")

ohos_unittest("adapter_manager_aiut") {
  testonly = true
  module_out_path = "audio_framework/hdiadapter/adapter_manager"

  cflags = [
    "-Wall",
    "-Werror",
    "-Wno-macro-redefined",
    "-fno-access-control",
  ]

  include_dirs = [
    "include",
    # Device manager mock
    "../device_manager/include",
    # Main source includes
    "../../../include",
    "../../../include/util",
    # Common test includes
    "../../../../../../../test/unittest/common/include",
    "../../../../../../../interfaces/inner_api/native/audiocommon/include",
    # Sibling module includes
    "../../../../../audioutils/include",
    "../../../../../audioclock/include",
    "../../../../../audiodefinitions/include",
  ]

  sources = [
    "src/hdi_adapter_factory_aiut.cpp",
    "src/hdi_monitor_aiut.cpp",
    # Source files under test
    "../../../manager/hdi_adapter_manager.cpp",
    "../../../manager/hdi_adapter_factory.cpp",
    "../../../manager/hdi_monitor.cpp",
    "../../../adapter/bluetooth_device_manager.cpp",
    "../../../adapter/local_device_manager.cpp",
    "../../../adapter/remote_device_manager.cpp",
    "../../../util/callback_wrapper.cpp",
    "../../../util/id_handler.cpp",
    "../../../util/ring_buffer_handler.cpp",
  ]

  defines = [ "FEATURE_DISTRIBUTE_AUDIO" ]

  if (audio_framework_feature_multi_user_zone) {
    defines += [ "MULTI_USER_ZONE" ]
  }

  deps = [
    "../../../..:hdiadapter_new",
    "../../../../../audioclock:audio_clock",
    "../../../../../audioutils:audio_utils",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "googletest:gtest",
    "googletest:gmock",
    "init:libbegetutil",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "drivers_interface_audio:libaudio_proxy_6.1",
    "drivers_interface_bluetooth:hdi_audio_bluetooth_header",
    "hdf_core:libhdf_ipc_adapter",
    "drivers_interface_distributed_audio:libdaudio_proxy_2.0",
    "media_foundation:media_monitor_client",
    "media_foundation:media_monitor_common",
  ]

  part_name = "audio_framework"
  subsystem_name = "multimedia"
}
