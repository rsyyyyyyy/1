# Audio Suite SA 服务端 IDL 接口库版本脚本
# 确保导出 Stub 类和接口相关的所有符号

1.0 {
  global:
    # IAudioSuiteSaService 接口符号
    *IAudioSuiteSaService*;
    *AudioSuiteSaServiceProxy*;
    *AudioSuiteSaServiceStub*;

    # IUpdateEngineCallback 接口符号
    *IUpdateEngineCallback*;
    *UpdateEngineCallbackProxy*;
    *UpdateEngineCallbackStub*;

    # IDownloadCallback 接口符号
    *IDownloadCallback*;
    *DownloadCallbackProxy*;
    *DownloadCallbackStub*;

    # ICloudRomDownloadCallback 接口符号
    *ICloudRomDownloadCallback*;
    *CloudRomDownloadCallbackProxy*;
    *CloudRomDownloadCallbackStub*;

    # AudioSuiteSaTypes 类型符号
    *AudioSuiteSaTypes*;
    *SharedMemoryInfo*;
    *DownloadStatus*;
    *DownloadState*;
    *CloudRomStatus*;
    *SecurityLevel*;
    *BusinessError*;
    *FeatureInfo*;
    *StatusInfo*;
    *CloudRomNewVersionInfo*;
    *CloudRomCheckResult*;
    *StatusInfoResult*;
    *CheckCondition*;
    *DownloadCondition*;
    *PauseCondition*;
    *CloudRomCallback*;

    # GetDescriptor 符号（iface_cast 需要）
    *GetDescriptor*;

    # OnRemoteRequest 符号（IPC 需要）
    *OnRemoteRequest*;

    # AsObject 符号
    *AsObject*;

    # QueryInterface 符号
    *QueryInterface*;

    # vtable 和 VTT 符号（虚函数表）
    *vtable*;
    *VTT*;

    # 类型信息符号
    *typeinfo*;

  local:
    *;
};