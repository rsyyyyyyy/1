import("//build/config/features.gni")
import("//build/test.gni")

ohos_fuzztest("HpaeDelayedTaskQueueFuzzTest") {
  module_out_path = "audio_framework/audio_framework_engine"
  fuzz_config_file = "../hpae_delayed_task_queue_fuzzer"

  include_dirs = [
    "../../../services/audio_engine/utils",
    "../../../interfaces/inner_api/native/audiocommon/include",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  cflags_cc = cflags
  cflags_cc += [ "-fno-access-control" ]

  sources = [ "hpae_delayed_task_queue_fuzzer.cpp" ]

  deps = [
    "../../../services/audio_engine:audio_engine_utils",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "hilog:libhilog",
  ]
}

group("fuzztest") {
  testonly = true
  deps = [ ":HpaeDelayedTaskQueueFuzzTest" ]
}
