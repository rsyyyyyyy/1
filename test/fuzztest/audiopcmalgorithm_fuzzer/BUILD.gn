import("//build/ohos.gni")
import("//build/test.gni")
import("../../../config.gni")

ohos_fuzztest("AudioPcmAlgorithmFuzzTest") {
  module_out_path = "audio_framework/audio_framework_engine"
  fuzz_config_file = "../audiopcmalgorithm_fuzzer"

  include_dirs = [
    "../../../services/audio_engine/plugin/resample/include",
    "../../../services/audio_engine/plugin/channel_converter/include",
    "../../../interfaces/inner_api/native/audiocommon/include",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  sources = [
    "audiopcmalgorithm_fuzzer.cpp",
  ]

  cflags_cc = [ "-std=c++20" ]

  deps = [
    "../../../services/audio_engine:audio_common_algorithm",
  ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hilog:libhilog",
  ]

  defines = []
}

group("fuzztest") {
  testonly = true
  deps = [ ":AudioPcmAlgorithmFuzzTest" ]
}
