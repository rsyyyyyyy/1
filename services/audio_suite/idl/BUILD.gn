import("//build/config/components/idl_tool/idl.gni")
import("//foundation/multimedia/audio_framework/config.gni")

audio_framework_root = "../../.."

config("audio_suite_idl_config") {
  include_dirs = [
    "${audio_framework_root}/interfaces/inner_api/native/audiocommon/include",
    "${audio_framework_root}/services/audio_suite/idl",
    "${target_gen_dir}",
  ]
}

idl_gen_interface("audio_suite_idl_interface") {
  sources = [
    "IAudioSuiteService.idl",
    "IAudioSuiteDownloadCallback.idl",
    "IAudioSuiteStatusCallback.idl",
  ]
  sources_callback = []
  sources_common = [ "AudioSuiteTypes.idl" ]

  inputs = [
    "AudioSuiteTypes.idl",
  ]

  configs = [ ":audio_suite_idl_config" ]

  log_tag = "AudioSuiteSaIdl"
  hitrace = "HITRACE_TAG_ZAUDIO"
  log_domainid = "0xD002B8C"

  subsystem_name = "multimedia"
  part_name = "audio_framework"
}

if (audio_framework_feature_audiosuite_support) {
  ohos_shared_library("audio_suite_client_idl") {
    install_enable = true
    branch_protector_ret = "pac_ret"

    cflags_cc = [
      "-fomit-frame-pointer",
      "-fdata-sections",
      "-ffunction-sections",
      "-fvisibility-inlines-hidden",
      "-fno-unroll-loops",
      "-fno-exceptions",
      "-fno-unwind-tables",
      "-fno-asynchronous-unwind-tables",
      "-Os",
    ]

    ldflags = [
      "-Wl,-gc-sections",
    ]

    include_dirs = [
      "${audio_framework_root}/interfaces/inner_api/native/audiocommon/include",
    ]

    client_output_values = []
    client_output_values += filter_include(get_target_outputs(":audio_suite_idl_interface"),
      [ "*service_proxy.cpp", "*callback_stub.cpp", "*_types.cpp" ])

    sources = []
    sources += client_output_values

    deps = [
      ":audio_suite_idl_interface",
      "${audio_framework_root}/frameworks/native/audioutils:audio_utils",
    ]

    external_deps = [
      "c_utils:utils",
      "hilog:libhilog",
      "ipc:ipc_core",
      "ipc:ipc_single",
      "hitrace:hitrace_meter",
    ]

    public_configs = [ ":audio_suite_idl_config" ]

    subsystem_name = "multimedia"
    part_name = "audio_framework"

    sanitize = {
      cfi = true
      cfi_cross_dso = true
      debug = false
    }

    version_script = "libaudio_suite_client_idl.versionscript"
  }
}

if (audio_framework_feature_audiosuite_support) {
  ohos_shared_library("audio_suite_server_idl") {
    install_enable = true
    branch_protector_ret = "pac_ret"

    cflags_cc = [
      "-fomit-frame-pointer",
      "-fdata-sections",
      "-ffunction-sections",
      "-fvisibility-inlines-hidden",
      "-fno-unroll-loops",
      "-fno-exceptions",
      "-fno-unwind-tables",
      "-fno-asynchronous-unwind-tables",
      "-Os",
    ]

    ldflags = [
      "-Wl,-gc-sections",
    ]

    include_dirs = [
      "${audio_framework_root}/interfaces/inner_api/native/audiocommon/include",
    ]

    server_output_values = []
    server_output_values += filter_include(get_target_outputs(":audio_suite_idl_interface"),
      [ "*service_stub.cpp", "*callback_proxy.cpp", "*_types.cpp" ])
    sources = []
    sources += server_output_values

    deps = [
      ":audio_suite_idl_interface",
      "${audio_framework_root}/frameworks/native/audioutils:audio_utils",
    ]

    external_deps = [
      "c_utils:utils",
      "hilog:libhilog",
      "ipc:ipc_core",
      "ipc:ipc_single",
      "samgr:samgr_proxy",
      "hitrace:hitrace_meter",
    ]

    public_configs = [ ":audio_suite_idl_config" ]

    subsystem_name = "multimedia"
    part_name = "audio_framework"

    sanitize = {
      cfi = true
      cfi_cross_dso = true
      debug = false
    }

    version_script = "libaudio_suite_server_idl.versionscript"
  }
}

group("audio_suite_idl_headers") {
  deps = [
    ":audio_suite_idl_interface",
  ]
}