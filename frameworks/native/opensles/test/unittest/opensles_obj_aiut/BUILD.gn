import("//build/test.gni")
import("../../../../../config.gni")

module_output_path = "audio_framework/audio_framework_common/opensles_obj"

config("opensles_obj_aiut_config") {
  include_dirs = [
    "./include",
    "../../../include",
    "../../../../../test/unittest/common/include",
  ]

  cflags = [
    "-Wall",
    "-Werror",
    "-fno-access-control",
  ]
}

ohos_unittest("opensles_obj_aiut") {
  testonly = true
  module_out_path = module_output_path

  configs = [ ":opensles_obj_aiut_config" ]

  sources = [
    "src/opensles_obj_aiut.cpp",
    "../../../opensles/src/obj/engine_obj.cpp",
    "../../../opensles/src/obj/output_mix_obj.cpp",
  ]

  deps = [
    "../../../opensles:opensles",
  ]

  external_deps = [
    "hilog:libhilog",
  ]
}

group("opensles_obj_aiut_group") {
  testonly = true
  deps = [ ":opensles_obj_aiut" ]
}